# =============================================================================
# RankLens API — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git!
# =============================================================================

# ---------- App ----------
APP_BASE_URL=https://your-app.onrender.com
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_SECRET=change-me-to-a-strong-random-secret

# ---------- Database ----------
# SQLite (default, zero-config for local dev & Render free tier)
DATABASE_URL=sqlite+aiosqlite:///./data/ranklens.db
# Supabase Postgres (production upgrade path):
# DATABASE_URL=postgresql+asyncpg://user:password@db.supabase.co:5432/postgres

# ---------- Stripe ----------
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
# Get from: https://dashboard.stripe.com/webhooks (after creating webhook)
STRIPE_WEBHOOK_SECRET=whsec_...

# Map your Stripe Price IDs to plans (comma-separated key=value pairs)
# Example: price_abc123=starter,price_def456=pro,price_ghi789=agency
STRIPE_PRICE_MAP=price_STARTER_ID=starter,price_PRO_ID=pro,price_AGENCY_ID=agency

# ---------- AI (Gemini Flash - Free Tier) ----------
# Get from: https://aistudio.google.com/app/apikey  (FREE, no credit card)
GEMINI_API_KEY=AIza...

# ---------- Email (Resend - 3,000 emails/month FREE) ----------
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_...
# The "From" email address (must be verified in Resend)
EMAIL_FROM=RankLens <noreply@yourdomain.com>
